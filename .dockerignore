# Build artefacts are produced inside the image
/vendor
/node_modules
/public/build
/public/hot
/public/storage

# Secrets and local state never enter the image
.env
.env.*
!/docker/env.example
/storage/*.key
/storage/app/*
!/storage/app/.gitignore
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/framework/testing
/storage/logs/*
/storage/pail
/bootstrap/cache/*.php
/bootstrap/cache/*.tmp
/database/*.sqlite

# Tooling, documents and editor state
/.git
/.github
/.claude
/.agents
/.playwright-mcp
/.idea
/.vscode
/.fleet
/.nova
/.zed
/reports
/loadtest
/coverage
/.phpunit.cache
/.phpunit.result.cache
/phpunit.xml
/tests
/node_modules/.cache
*.log
*.docx
*.pdf
Thumbs.db
.DS_Store

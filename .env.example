# ─── PRODUCTION SECURITY REQUIREMENTS ───────────────────────────────────────
# APP_DEBUG must be false in production.
# SESSION_SECURE_COOKIE must be true when HTTPS is active.
# Never commit real secrets to version control.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=Laravel
# PRODUCTION: set APP_ENV=production
APP_ENV=local
APP_KEY=
# PRODUCTION: set APP_DEBUG=false
APP_DEBUG=false
# PRODUCTION: set APP_URL to your HTTPS domain, e.g. https://euisis.addisababa.gov.et
APP_URL=http://localhost
# Local phone/tablet testing only: set this to the development computer's LAN
# IPv4 address (for example, 192.168.8.2). Do not use it in production.
# VITE_DEV_SERVER_HOST=192.168.8.2
# VITE_DEV_SERVER_PORT=5173
# PRODUCTION behind a reverse proxy / load balancer: its IPs or CIDRs, comma-separated
# (config/trustedproxy.php). Leave empty when the app server faces clients directly.
APP_TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# PRODUCTION: use LOG_STACK=daily to get rotating log files
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# PRODUCTION: set LOG_LEVEL=warning or LOG_LEVEL=error to avoid verbose logs in production
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=
# PostgreSQL only — PRODUCTION: require (or verify-full). See .env.production.
# DB_SSLMODE=prefer

SESSION_DRIVER=database
# Fallback idle timeout (minutes) used only when System Settings cannot be
# read. The real idle timeout is System Settings -> Security -> Session Timeout
# Minutes; Laravel's storage lifetime is derived as idle + grace (below).
SESSION_LIFETIME=120
SESSION_STORAGE_GRACE_MINUTES=30
# PRODUCTION: must be true — encrypts session payload at rest
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
# Defaults to true when APP_URL is https://. Set explicitly only to override;
# `php artisan security:production-check` fails a production deploy without it.
# SESSION_SECURE_COOKIE=true
# Cookie is HTTP-only by default; keep true so JS cannot read the session cookie
SESSION_HTTP_ONLY=true
# SameSite policy for the session cookie. Keep "lax": "strict" signs users out
# of every tab when they open a link to EUISIS from email or another site.
SESSION_SAME_SITE=lax

# ─── Sanctum ────────────────────────────────────────────────────────────────
# Token expiration in minutes. 480 = 8 hours. 43200 = 30 days (too long for production).
# PRODUCTION: use 480 (8 hours) or 60 (1 hour) for stricter token rotation.
SANCTUM_TOKEN_EXPIRATION_MINUTES=480

# ─── CORS ───────────────────────────────────────────────────────────────────
# PRODUCTION: set to your exact HTTPS domain — never use * in production
# CORS_ALLOWED_ORIGINS=https://euisis.addisababa.gov.et

# ─── Sanctum token prefix ────────────────────────────────────────────────────
# Prefix helps secret-scanning tools (GitHub, GitLab) detect accidentally committed tokens
SANCTUM_TOKEN_PREFIX=euisis_

# ─── Auth / Registration ────────────────────────────────────────────────────
# Public self-service registration is OFF by default. Admins create accounts.
REGISTRATION_ENABLED=false

# ─── MFA ────────────────────────────────────────────────────────────────────
# Roles (comma-separated, exact role names) that MUST enrol TOTP MFA.
# PRODUCTION: expand to include all roles with access to employee PII.
MFA_REQUIRED_ROLES="Super Admin,City Admin,HR Manager,Cafeteria Admin,Security Officer"

# ─── Demo data (development / QA / UAT only) ────────────────────────────────
# Password for the accounts `php artisan db:seed --class=DemoDataSeeder` creates.
# Required outside local/testing; demo seeding always refuses production.
# DEMO_USER_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Backup status integration (docs/runbooks/backup-health-troubleshooting.md). Server-side only:
# never VITE_*. Repository cipher passwords stay in pgBackRest's own config, never here.
# Off = NOT_CONFIGURED (development) / CRITICAL (production). Never reports healthy.
BACKUP_STATUS_ENABLED=false
# pgbackrest: run fixed read-only pgBackRest commands here; report: read the ops runner report.
BACKUP_DRIVER=pgbackrest
BACKUP_ENFORCE_PRODUCTION_RULES=false
BACKUP_PITR_REQUIRED=true
BACKUP_STATUS_CACHE_SECONDS=60
PGBACKREST_BINARY=/usr/bin/pgbackrest
PGBACKREST_STANZA=euisis
# Optional absolute --config path. Leave empty when using PGBACKREST_RUN_AS.
PGBACKREST_CONFIG=
# Optional: run as this OS account via "sudo -n" and an exact sudoers rule, so PHP never reads
# the pgBackRest configuration or repository keys.
PGBACKREST_RUN_AS=
PGBACKREST_SUDO_BINARY=/usr/bin/sudo
PGBACKREST_TIMEOUT_SECONDS=20
PGBACKREST_CHECK_TIMEOUT_SECONDS=120
BACKUP_STATUS_PATH=/var/lib/euisis-backup/status.json
BACKUP_REPORT_STALE_MINUTES=15
BACKUP_STALE_HOURS=30
BACKUP_CRITICAL_HOURS=48
BACKUP_FULL_STALE_DAYS=8
BACKUP_VERIFY_STALE_DAYS=8
BACKUP_RESTORE_TEST_DAYS=35
BACKUP_WAL_LAG_SECONDS=600
BACKUP_WAL_BACKLOG_SEGMENTS=16
BACKUP_STORAGE_WARNING_PERCENT=80
BACKUP_ALERT_REPEAT_MINUTES=360
BACKUP_ALERT_USER_IDS=
BACKUP_ALERT_MAIL=false
BACKUP_RETENTION_FULL_COUNT=12
BACKUP_LOGICAL_ENABLED=false
BACKUP_LOGICAL_STALE_DAYS=35
BACKUP_REPOSITORY_1_NAME="Private repository"
BACKUP_REPOSITORY_2_NAME="Independent off-site repository"
BACKUP_RPO=NEEDS_DECISION
BACKUP_RTO=NEEDS_DECISION

VITE_APP_NAME="${APP_NAME}"

# Paid SMS spend caps (0 disables a cap). SMS_ENABLED=false is the kill switch.
# Also set a hard spending limit in the SMS provider account.
SMS_ENABLED=true
SMS_DAILY_CAP=500
SMS_MONTHLY_CAP=10000
SMS_PER_RECIPIENT_DAILY_CAP=8

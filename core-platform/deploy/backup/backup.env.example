# Core backup configuration (core-backup.sh). TEMPLATE: install as
# /etc/core-backup/backup.env, mode 0600, owned by the backup account; replace
# every REPLACE_* after the host topology is confirmed. No password belongs here:
# the database connection uses ~/.pgpass or PGSERVICE of the backup account.

# Database: pgbackrest (physical + WAL, the primary path), pg_dump (logical), or both.
BACKUP_DB_TOOL=both
PGBACKREST_STANZA=core
PGBACKREST_TYPE=diff            # cron runs "full" weekly by overriding this
PG_DUMP=/usr/lib/postgresql/18/bin/pg_dump
PGSERVICE=core_backup           # ~/.pg_service.conf: host, port, dbname, a read-only backup role
PGDATABASE=REPLACE_CORE_DATABASE

# The application, for core:snapshot (counts and checksums for the restore comparison).
CORE_APP=/srv/core/current/backend
PHP=/usr/bin/php8.4

# The private disks: employee documents, photos and signatures (evidence), imports, exports.
FILES_ROOT=/srv/core/shared/storage/app/private

# Local repository (its own volume, not the database or application disk) and the off-host copy.
BACKUP_REPO=/var/backups/core
OFFHOST_CMD='rclone copy {dir} REPLACE_REMOTE:core-backups/ --immutable --checksum'
# or: OFFHOST_DIR=/mnt/REPLACE_OTHER_HOST_MOUNT/core-backups   (checked with sha256sum after the copy)

# Encryption to a public key; the private key is escrowed for restores (docs/runbook/core-backup-and-restore.md).
GPG_RECIPIENT=REPLACE_BACKUP_KEY_FINGERPRINT
GNUPGHOME=/var/lib/core-backup/gnupg

# Retention: number of runs kept in each place. RPO/RTO are a business decision (see the runbook).
RETAIN_COUNT=14
RETENTION_DAYS=14

# What the Core reads (CORE_BACKUP_STATUS_FILE): readable by the PHP-FPM user, writable only by the backup account.
STATUS_FILE=/var/lib/core-backup/status.json

# Run on failure, after the status file records it, e.g. an alert to the operations channel.
ALERT_CMD='REPLACE_ALERT_COMMAND "Core backup failed on $(hostname)"'

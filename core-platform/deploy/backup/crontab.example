# Core backups and restore drills, for the BACKUP account's crontab (not the web user's).
# EXAMPLE cadence: set the real one after the RPO/RTO decision and after timing real runs.
# Failures write the status file (System Health turns critical) and run ALERT_CMD; the
# external monitor also alerts when /health/monitor reports backup_age_hours too high.
SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
BACKUP_CONFIG=/etc/core-backup/backup.env
# Weekly full, daily differential (pgBackRest) with the logical dump and the files each night.
15 1 * * 0   PGBACKREST_TYPE=full /opt/core/deploy/backup/core-backup.sh >> /var/log/core-backup/backup.log 2>&1
15 1 * * 1-6 /opt/core/deploy/backup/core-backup.sh >> /var/log/core-backup/backup.log 2>&1
# Repository checks.
0 6 * * 1    pgbackrest --stanza=core verify >> /var/log/core-backup/verify.log 2>&1
# Monthly restore drill on the ISOLATED restore host, from the off-host copy (its own crontab):
# 0 3 1 * *  RESTORE_ROOT=/srv/restore-drill/$(date +\%Y\%m) ... /opt/core/deploy/backup/core-restore-drill.sh <latest off-host backup> /secure/drill-account.json

APP_NAME="Cafeteria System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

# ── Local cafeteria database ────────────────────────────────────────────
# This is the CAFETERIA database only. It must NEVER point at the EUISIS
# database — the two systems share no tables.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=cafeteria_db
DB_USERNAME=cafeteria
DB_PASSWORD=

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── EUISIS integration ──────────────────────────────────────────────────
# Base URL of the EUISIS Unified ID system (no trailing slash).
EUISIS_API_BASE_URL=http://127.0.0.1:8000

# Bearer token issued by EUISIS. ALWAYS keep the quotes — a pasted value
# containing spaces or commas will otherwise break .env parsing entirely. → System Settings → API Management.
# Shown once at generation; store it in the environment, never in code.
EUISIS_API_TOKEN=""

# Seconds to wait for an EUISIS response before failing closed.
EUISIS_API_TIMEOUT=10

# Provider code identifying this cafeteria installation.
CAFETERIA_PROVIDER_CODE=

# Max scan verifications per minute, per provider user.
CAFETERIA_SCAN_RATE_LIMIT=30

# dompdf writes a copy of each embedded font, with its metrics, the first time
# a PDF uses it (config/typography.php). The name carries a hash of where the
# font was found, so every machine and checkout produces its own set. They are
# a runtime cache: ignored so test runs and servers do not leave stray files.
# Copies already in the repository stay tracked.
*_????????????????????????????????.ttf
*_????????????????????????????????.ufm
*_????????????????????????????????.ufm.json
# The registry of installed fonts (dompdf rebuilds it on first use); it holds
# absolute paths of the machine that wrote it.
installed-fonts.json
